          <mxGeometry height="120" width="300" x="120" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;" value="5. 컬럼 분류 &amp; 탐색적 분석(EDA)&lt;br&gt;COL 딕셔너리로 타입 명시 분류, 파생 전/후 분포·상관관계 확인" vertex="1">
          <mxGeometry height="90" width="380" x="480" y="1190" as="geometry" />
