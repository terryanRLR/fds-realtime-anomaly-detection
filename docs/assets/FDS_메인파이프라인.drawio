        <mxCell id="s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;" value="4. 데이터 분할&lt;br&gt;StratifiedGroupKFold(n=5), 1번째 fold를 80/20 홀드아웃으로 사용&lt;br&gt;group key: Customer_identification_number" vertex="1">
          <mxGeometry height="100" width="380" x="480" y="900" as="geometry" />
        </mxCell>
