        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;" value="7. 인코딩&lt;br&gt;OrdinalEncoder + 빈도 인코딩&lt;br&gt;train(df_tr)에만 fit → df_tr/df_va 양쪽에 동일 적용" vertex="1">
          <mxGeometry height="90" width="380" x="480" y="1450" as="geometry" />
        </mxCell>
