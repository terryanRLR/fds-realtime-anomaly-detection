        <mxCell id="s6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;" value="6. 피처 엔지니어링&lt;br&gt;시간·금액·위협·관계 4개 영역, 26개 파생 피처 생성&lt;br&gt;ratio 변수는 NaN + 별도 flag 처리" vertex="1">
          <mxGeometry height="100" width="380" x="480" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="note_derivation" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#78909C;dashed=1;fontSize=11;fontColor=#37474F;" value="가설 → 데이터 검증 → 채택/보정/폐기&lt;br&gt;상세: FDS_파생변수_근거표.md" vertex="1">
