        <mxCell id="s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;fontSize=13;" value="1. 문제정의&lt;br&gt;온라인 거래 데이터로 사기 유형 13-class 분류" vertex="1">
