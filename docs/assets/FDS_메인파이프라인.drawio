          <mxGeometry height="110" width="170" x="585" y="750" as="geometry" />
        </mxCell>
        <mxCell id="fix_quality" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=12;" value="품질 보정&lt;br&gt;UTF-8 BOM 처리, Time_difference 초 단위 변환&lt;br&gt;음수 시간 NaN 처리, 금액 부호 분리" vertex="1">
          <mxGeometry height="120" width="300" x="120" y="745" as="geometry" />
