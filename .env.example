# ══════════════════════════════════════════════════════════
# FDS 대시보드 환경 설정 템플릿
#   이 파일을 .env 로 복사한 뒤 값을 채우세요.   cp .env.example .env
#   우선순위: 대시보드 사이드바 입력 > .env > 기본값
#
#   ⚠️ .env 는 .gitignore 에 등록돼 있습니다. 절대 커밋하지 마세요.
#   ⚠️ Streamlit Cloud 는 .env 를 읽지 않습니다 —
#      App settings > Secrets 에 같은 키를 등록하세요.
# ══════════════════════════════════════════════════════════

# ── LLM 기본 제공자: local | anthropic | openai | deepseek | moonshot | custom | fallback
USE_LLM_PROVIDER=local

# ── 로컬 (llama.cpp) — local 선택 시 필수
#    Streamlit Cloud 에는 llama.cpp 가 없으므로 local 이외를 쓰세요.
LLAMA_CPP_URL=http://localhost:8080/v1/chat/completions

# ── Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OpenAI
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# ── DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ── Moonshot
MOONSHOT_API_KEY=
MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions
MOONSHOT_MODEL=moonshot-v1-8k

# ── 🌐 커스텀 (OpenAI 호환이면 무엇이든: OpenRouter / Together / Groq / vLLM / LM Studio)
#    URL은 chat/completions 전체 경로를 입력합니다.
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_URL=https://openrouter.ai/api/v1/chat/completions
CUSTOM_LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ── 알림 (Slack Webhook / Gmail SMTP)
#    SMTP_PASS 는 Gmail 계정 비밀번호가 아니라 '앱 비밀번호'(16자)입니다.
SLACK_WEBHOOK_URL=
SMTP_USER=
SMTP_PASS=

# 📮 이상거래 알림 수신자 (대시보드의 '수신자 이메일'을 비워두면 이 값 사용)
FDS_NOTIFY_EMAIL=

# ══════════════════════════════════════════════════════════
# 배포 시 권장 (경로 고정 — 미설정 시 '실행 디렉터리 기준'이라
#              엉뚱한 위치에 빈 DB 가 생기고 화면이 비어 보입니다)
# ══════════════════════════════════════════════════════════
# FDS_DB_PATH=C:\fds\fds_results.db
# FDS_MODEL_DIR=models
# FDS_LOG_PATH=watcher.log
