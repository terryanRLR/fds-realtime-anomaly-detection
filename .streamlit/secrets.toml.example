# ══════════════════════════════════════════════════════════
# Streamlit Cloud 용 비밀값 템플릿
#
#  · Cloud 배포:  앱 페이지 > ⋮ > Settings > Secrets 에
#                 아래 내용을 그대로 붙여넣습니다. (파일 업로드 아님)
#  · 로컬 테스트: 이 파일을 .streamlit/secrets.toml 로 복사.
#                 단 로컬은 .env 만으로도 충분합니다 — 굳이 둘 다 둘 필요 없습니다.
#
#  🔴 secrets.toml 은 .gitignore 로 막혀 있습니다. 커밋하지 마세요.
#     (이 .example 파일에는 절대 실제 값을 적지 마세요)
#
#  값이 os.environ 으로 올라가는 경로: secrets_bridge.load_secrets_into_env()
#  우선순위: 실제 환경변수 / .env  >  st.secrets  >  코드 기본값
# ══════════════════════════════════════════════════════════

# ── LLM 제공자 ────────────────────────────────────────────
#  ⚠️ Cloud 에는 llama.cpp 서버가 없습니다. "local" 을 쓰면 LLM 분석이
#     전부 폴백 템플릿으로 떨어집니다. Cloud 에서는 클라우드 제공자를 고르세요.
USE_LLM_PROVIDER = "anthropic"

ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL   = "claude-sonnet-4-6"

# OPENAI_API_KEY = ""
# OPENAI_API_URL = "https://api.openai.com/v1/chat/completions"
# OPENAI_MODEL   = "gpt-4o-mini"

# 커스텀(OpenAI 호환: OpenRouter / Together / Groq / vLLM …)
# CUSTOM_LLM_API_KEY = ""
# CUSTOM_LLM_URL     = "https://openrouter.ai/api/v1/chat/completions"
# CUSTOM_LLM_MODEL   = "meta-llama/llama-3.3-70b-instruct"

# ── 알림 ──────────────────────────────────────────────────
#  섹션으로 묶어도 됩니다 — secrets_bridge 가 한 단계 펼쳐 평면 키로 읽습니다.
[notify]
SLACK_WEBHOOK_URL = ""
SMTP_USER         = ""
SMTP_PASS         = ""          # Gmail 계정 비밀번호가 아니라 '앱 비밀번호'(16자)
FDS_NOTIFY_EMAIL  = ""

# ── 경로 ──────────────────────────────────────────────────
#  ⚠️ Cloud 의 파일시스템은 휘발성입니다. 앱이 재시작되면 fds_results.db 에
#     쌓인 탐지 이력이 사라집니다. 이력을 보존하려면 외부 DB 가 필요합니다.
[paths]
# FDS_DB_PATH   = "fds_results.db"
FDS_MODEL_DIR = "models"
